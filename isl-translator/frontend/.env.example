# Where the backend lives. Set this in Vercel (Project -> Settings -> Environment
# Variables) to the Render URL, with no trailing slash:
#
#     VITE_API_BASE=https://signbridge-backend.onrender.com
#
# Vite reads it at BUILD time, not at run time, so changing it needs a redeploy.
# Leave it empty locally: the backend serves the page itself there, and relative
# paths are correct.
VITE_API_BASE=
